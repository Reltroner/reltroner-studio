{
  "name": "learn-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run assets:sync",
    "build": "next build",
    "assets:sync": "node --no-warnings --experimental-loader ./tools/test-loader.mjs tools/sync-first-party-assets.mjs",
    "assets:verify": "node tools/verify-first-party-export.mjs",
    "assets:test": "node --no-warnings --experimental-loader ./tools/test-loader.mjs --test tests/security-assets.test.mjs tests/first-party-assets.test.mjs tests/security-rendering.test.mjs",
    "resources:audit": "node --loader ./tools/test-loader.mjs tools/audit-resource-references.mjs",
    "clean": "node -e \"const fs=require('fs'); for (const p of ['.next','out']) fs.rmSync(p,{recursive:true,force:true});\"",
    "build:clean": "npm run clean && npm run build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "content:validate": "node tools/validate-content.mjs",
    "canon:qa:report": "node tools/audit-asthortera-cross-domain.mjs --json",
    "canon:qa:strict": "node tools/audit-asthortera-cross-domain.mjs",
    "postbuild": "node node_modules/next-sitemap/bin/next-sitemap.mjs && npm run assets:verify",
    "check-slugs": "node tools/check-slugs.mjs",
    "check-all-slugs": "node tools/check-all-slugs.mjs",
    "test:worldbuilding": "node --test tests/asthortera-nccm-baseline.test.mjs tests/asthortera-cross-domain-regression.test.mjs tests/asthortera-nccm-v6-active.test.mjs tests/asthortera-canon-profile-renderer.test.mjs tests/asthortera-nccm-v65-integrated-profiles.test.mjs tests/asthortera-nccm-v65-crossdocs.test.mjs",
    "audit:worldbuilding": "node tools/audit-asthortera-cross-domain.mjs",
    "canon:nations:check": "node tools/sync-asthortera-nccm-profiles.mjs --check",
    "canon:nations:sync": "node tools/sync-asthortera-nccm-profiles.mjs --write",
    "canon:v65:reconcile:check": "node tools/reconcile-asthortera-nccm-v65.mjs --check",
    "canon:v65:reconcile:write": "node tools/reconcile-asthortera-nccm-v65.mjs --write",
    "canon:v65:crossdocs:check": "node tools/sync-asthortera-nccm-crossdocs.mjs --check",
    "canon:v65:crossdocs:write": "node tools/sync-asthortera-nccm-crossdocs.mjs --write"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.1",
    "@radix-ui/react-dialog": "1.1.7",
    "@radix-ui/react-visually-hidden": "^1.1.3",
    "axios": "^1.9.0",
    "chalk": "^5.4.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.16.0",
    "fs": "^0.0.1-security",
    "gray-matter": "^4.0.3",
    "hast-util-sanitize": "5.0.2",
    "hast-util-to-html": "9.0.5",
    "lucide-react": "^0.487.0",
    "marked": "^15.0.7",
    "mdast-util-to-hast": "13.2.1",
    "micromark-util-decode-string": "2.0.1",
    "next": "^16.0.7",
    "next-sitemap": "^4.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.2.7",
    "react-google-recaptcha": "^3.1.0",
    "redis": "^4.7.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/hast": "3.0.4",
    "@types/mdast": "4.0.4",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "postcss": "^8.5.3",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "unified": "11.0.5"
  }
}
