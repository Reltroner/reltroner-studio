# Configure real values only in private .env.local or the approved hosting secret store.
# The server provider needs contact read/write access to the owner's approved segment.
# Keys alone do NOT activate subscriptions. See docs/newsletter-and-contact-release.md.
RESEND_API_KEY=
RESEND_SEGMENT_ID=
# Operator gate: set true ONLY after Free/no-overages, Contacts read/write permissions,
# approved segment, privacy, Broadcast unsubscribe and published Vercel WAF are verified.
# No email-sending code is enabled by this flag. Default false makes zero provider calls.
RESEND_NEWSLETTER_ENABLED=false

# Public Web3Forms identifier by provider design; never use a Resend secret here.
# Browser-direct wiring is approved. Recipient/site/Free account must be verified.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Public flags and identifiers are embedded at BUILD time; redeploy after changing.
NEXT_PUBLIC_WEB3FORMS_ENABLED=false
